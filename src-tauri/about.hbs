<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Blankey third-party licenses</title>
<style>
  body { font: 14px/1.5 -apple-system, "Segoe UI", sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; color: #222; }
  h2 { margin-top: 2em; border-bottom: 1px solid #ddd; }
  pre { white-space: pre-wrap; background: #f6f6f6; padding: 1em; font-size: 12px; }
  .used { color: #555; font-size: 13px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Blankey is MIT licensed. It is built with the components below, under their own licenses.</p>
<h2>Licenses used</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
<li><a href="#bundled">Bundled libraries and fonts</a></li>
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p class="used">Used by: {{#each used_by}}<a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}}, {{/unless}}{{/each}}</p>
<pre>{{text}}</pre>
{{/each}}
<!-- BUNDLED -->
</body>
</html>
