{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blankey",
  "version": "0.2.2",
  "identifier": "io.blankey.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blankey",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Blankey",
    "homepage": "https://blankey.io",
    "category": "Productivity",
    "license": "MIT",
    "shortDescription": "Encrypted personal data vault that fills document templates",
    "longDescription": "Blankey keeps personal data in a local encrypted vault and fills docx, PDF-form and Typst templates with it. AI agents connect over MCP to build templates and map fields, but never see the values."
  }
}
